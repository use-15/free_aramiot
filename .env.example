# ------------------------------------------------------------------
# ARAMIOT - environment template
# Copy this file to .env and adjust the values for your machine.
# Never commit .env (it is git-ignored).
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# MongoDB (Community Edition, local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/aramiot

# Comma separated list of origins allowed to call the API from a browser.
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Serve the static frontend from the Express server (convenient for local dev).
SERVE_FRONTEND=true

# Public site URL, used for canonical/Open Graph metadata in the frontend.
SITE_URL=http://localhost:3000

# Dev only: start a throw-away in-memory MongoDB and seed sample data.
# Requires the mongodb-memory-server dev dependency. Never enable in production.
USE_IN_MEMORY_DB=false

# ==================================================================
# Phase 2 — Admin authentication (required to use /admin)
# ==================================================================
# A random secret used to sign the HTTP-only session JWT. Generate one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Keep it out of version control.
ADMIN_JWT_SECRET=

# A random secret used by the CSRF protection (double-submit token).
# Generate one the same way as ADMIN_JWT_SECRET if you prefer, or reuse a
# high-entropy string. Must be set before enabling admin auth.
CSRF_SECRET=

# Shared secret that authorizes the init-admin CLI to create the first
# Super Admin account. The admin auth routes reject init requests that do
# not present this header. Generate one the same way as ADMIN_JWT_SECRET.
ADMIN_INIT_SECRET=

# Set to "true" to disable the /api/admin/auth/init route entirely
# (recommended in production after the first Super Admin has been created).
ADMIN_INIT_DISABLED=false
